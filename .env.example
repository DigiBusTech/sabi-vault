# ====================================================================
# SABI VAULT: ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================
# Only the Supabase sovereign-node connection keys live here.
#
# Everything else (scoped-key signing secret, admin master key, Base
# Sepolia RPC + contract addresses + signer key, Gemini/Groq/OpenAI
# gateway keys, Google Drive / Dropbox OAuth credentials, billing split,
# sovereign node endpoints) is managed dynamically from the Super Admin
# dashboard (/dashboard > Configuration), stored AES-256-GCM encrypted in
# the platform_config table, and hot-reloaded at runtime.
#
# Bootstrap:
#   1. Fill in the three keys below.
#   2. Apply supabase/migrations (including 20261017120000_platform_config).
#   3. Register an account, then promote it:
#        node scripts/promote_super_admin.mjs you@example.com
#   4. Sign in and open /dashboard to configure all other keys.

# Supabase Sovereign Regional Database Node & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── CRITICAL SECURITY ─────────────────────────────────────────────────────────
# SESSION_SIGNING_SECRET: HMAC-SHA256 key used to sign/verify all Sabi Vault
# access tokens. MUST be set in production — the server will refuse to start
# without it. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SIGNING_SECRET=your-64-char-random-hex-secret-here

